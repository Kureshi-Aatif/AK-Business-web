<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main-content">
  <!-- Breadcrumbs -->
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">Plans &amp; Pricing</li>
      </ol>
    </nav>
  </div>

  <!-- Page Header -->
  <section class="section section--ice" style="padding-bottom: 40px;">
    <div class="container text-center">
      <div class="section-header reveal" style="margin-bottom: 0;">
        <span class="badge badge--orange section-badge">Transparent Pricing</span>
        <h1>Transparent Website Design Plans in Surat</h1>
        <p>
          Fair, upfront investments starting at ₹4,999 tailored for startups, retail catalogues, and expanding e-commerce brands in Surat and Gujarat.
        </p>
        <div style="margin-top: 18px; display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
          <button type="button" class="btn btn--outline-sky btn--sm btn-copy-plan" data-plan-slug="standard-catalogue">
            🔗 Copy plans link
          </button>
          <a href="/public/downloads/brochure.pdf" download="AK-Digital-Studio-Brochure.pdf" class="btn btn--white btn--sm" style="display: inline-flex; align-items: center; gap: 6px;">
            📄 Download brochure PDF
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 Plans Cards Section -->
  <section class="section">
    <div class="container">
      <div class="plans-grid">
        <!-- 1. Starter Website -->
        <article class="pricing-card reveal" id="starter-website">
          <div class="plan-header">
            <h3 class="plan-name">Starter Website</h3>
            <div class="plan-turnaround">Delivery: 3 to 5 Days</div>
            <div class="plan-price-box">
              <span class="plan-price">₹4,999</span>
              <span class="plan-price-suffix">onwards</span>
            </div>
            <p style="font-size: 0.9rem; margin-top: 8px;">
              Ideal for small businesses, professionals, and service providers establishing their primary digital presence.
            </p>
          </div>

          <ul class="plan-features">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>Up to 5 Pages:</strong> Home, About, Services, Gallery, Contact</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Mobile &amp; desktop fully optimized layout</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Basic lead contact form with auto-notification</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Direct WhatsApp click-to-chat integration</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Google Maps location embedding</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Fast loading speed &amp; clean code architecture</span>
            </li>
          </ul>

          <a href="/inquiry?plan=Starter+Website" class="btn btn--outline" style="width: 100%;">
            Choose Starter Plan
          </a>
        </article>

        <!-- 2. Standard Catalogue (Featured / Most Popular) -->
        <article class="pricing-card pricing-card--featured reveal" id="standard-catalogue">
          <div class="pricing-card__badge">MOST POPULAR</div>
          <div class="plan-header">
            <h3 class="plan-name">Standard Catalogue</h3>
            <div class="plan-turnaround" style="color: var(--color-bright);">Delivery: 7 to 10 Days</div>
            <div class="plan-price-box">
              <span class="plan-price" style="color: var(--color-royal);">₹9,999</span>
              <span class="plan-price-suffix">onwards</span>
            </div>
            <p style="font-size: 0.9rem; margin-top: 8px;">
              Engineered for manufacturers, wholesalers, and retail brands looking to showcase comprehensive product lines.
            </p>
          </div>

          <ul class="plan-features">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>Up to 10 Pages</strong> tailored to your brand identity</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>Up to 20 Products</strong> with structured categories</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Product images, titles, specs &amp; detailed descriptions</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Premium custom layout with bespoke visual hierarchy</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Basic on-page local SEO setup &amp; schema tags</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Full social media integration &amp; WhatsApp click-to-inquire</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Complete inquiry &amp; lead capture system with auto-routing</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Rigorous cross-device testing across smartphones and desktops</span>
            </li>
          </ul>

          <a href="/inquiry?plan=Standard+Catalogue" class="btn btn--primary" style="width: 100%;">
            Choose Catalogue Plan
          </a>
        </article>

        <!-- 3. E-commerce Solution -->
        <article class="pricing-card reveal" id="ecommerce-solution">
          <div class="plan-header">
            <h3 class="plan-name">E-commerce Solution</h3>
            <div class="plan-turnaround">Delivery: 12 to 15 Days</div>
            <div class="plan-price-box">
              <span class="plan-price">₹14,999</span>
              <span class="plan-price-suffix">onwards</span>
            </div>
            <p style="font-size: 0.9rem; margin-top: 8px;">
              Full-featured online store for brands selling directly to consumers with zero platform commissions.
            </p>
          </div>

          <ul class="plan-features">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Complete online store setup &amp; catalog architecture</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Initial product upload (<strong>50+ products</strong> included)</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Admin &amp; user management control panels</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Shopping cart &amp; secure multi-step checkout</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Payment gateway integration (UPI, QR, Cards, Netbanking)</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Order management &amp; customer inquiry dashboard</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>1-on-1 client training session on store management</span>
            </li>
          </ul>

          <a href="/inquiry?plan=E-commerce+Solution" class="btn btn--outline" style="width: 100%;">
            Choose E-commerce Plan
          </a>
        </article>
      </div>

      <!-- Add-ons List with Dotted Leaders -->
      <div class="addons-card reveal">
        <div style="text-align: center; max-width: 680px; margin: 0 auto 30px auto;">
          <span class="badge badge--sky" style="margin-bottom: 12px;">Customize Your Package</span>
          <h3>Popular Add-Ons &amp; Enhancements</h3>
          <p>Need extra features or specialized integrations? Combine any of our modular add-ons to fit your exact business goals.</p>
        </div>

        <div class="addons-list">
          <div class="addon-row">
            <span class="addon-title">Additional website page</span>
            <span class="addon-leader"></span>
            <span class="addon-price">₹800 onwards</span>
          </div>

          <div class="addon-row">
            <span class="addon-title">Dedicated high-converting landing page</span>
            <span class="addon-leader"></span>
            <span class="addon-price">₹2,000 onwards</span>
          </div>

          <div class="addon-row">
            <span class="addon-title">Advanced WhatsApp automation setup</span>
            <span class="addon-leader"></span>
            <span class="addon-price">₹500 onwards</span>
          </div>

          <div class="addon-row">
            <span class="addon-title">Custom contact / booking form</span>
            <span class="addon-leader"></span>
            <span class="addon-price">₹500 onwards</span>
          </div>

          <div class="addon-row">
            <span class="addon-title">Google Business Profile setup &amp; optimization</span>
            <span class="addon-leader"></span>
            <span class="addon-price">₹1,000 onwards</span>
          </div>

          <div class="addon-row">
            <span class="addon-title">Basic on-page SEO for existing websites</span>
            <span class="addon-leader"></span>
            <span class="addon-price">₹2,000 onwards</span>
          </div>

          <div class="addon-row">
            <span class="addon-title">Content formatting &amp; catalogue upload</span>
            <span class="addon-leader"></span>
            <span class="addon-price">₹500 onwards</span>
          </div>
        </div>

        <!-- Hosting & Support Policy Note -->
        <div style="margin-top: 36px; padding: 20px 24px; background: var(--color-ice); border-radius: var(--radius-md); border-left: 4px solid var(--color-royal);">
          <p style="font-size: 0.92rem; color: var(--color-navy); margin: 0;">
            <strong>Important note:</strong> Hosting and domain registration costs are separate (we assist you directly in setting up reliable, high-speed plans with Hostinger, MilesWeb, or Cloudflare). All new website projects include <strong>1 full year of basic setup support &amp; maintenance</strong>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="cta-band reveal">
        <h2>Unsure Which Plan Fits Your Business?</h2>
        <p>Send us your requirements or chat directly with Aatif Kureshi for a free, transparent consultation.</p>
        <div class="cta-band-actions">
          <a href="/inquiry" class="btn btn--primary btn--lg">Request custom recommendation</a>
          <a href="https://wa.me/<%= business.whatsappNumber.replace(/[^0-9]/g, '') %>?text=<%= encodeURIComponent('Hello Aatif, I need help choosing the right website plan for my business.') %>" target="_blank" rel="noopener" class="btn btn--white btn--lg">WhatsApp consultation</a>
        </div>
      </div>
    </div>
  </section>
</main>

<!-- JSON-LD Offer Schema for the Three Plans -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "AK Digital Studio Website Design Packages",
  "itemListElement": [
    {
      "@type": "Offer",
      "position": 1,
      "name": "Starter Website",
      "price": "4999",
      "priceCurrency": "INR",
      "description": "Up to 5 pages, mobile and desktop optimized, WhatsApp click-to-chat, and Google Maps integration.",
      "url": "<%= siteUrl %>/plans#starter-website"
    },
    {
      "@type": "Offer",
      "position": 2,
      "name": "Standard Catalogue",
      "price": "9999",
      "priceCurrency": "INR",
      "description": "Up to 10 pages, 20 products showcase, local SEO setup, and complete inquiry lead capture system.",
      "url": "<%= siteUrl %>/plans#standard-catalogue"
    },
    {
      "@type": "Offer",
      "position": 3,
      "name": "E-commerce Solution",
      "price": "14999",
      "priceCurrency": "INR",
      "description": "Complete online store, initial upload of 50+ products, shopping cart, admin panel, and payment gateway integration.",
      "url": "<%= siteUrl %>/plans#ecommerce-solution"
    }
  ]
}
</script>

<%- include('../partials/floating-wa') %>
<%- include('../partials/footer') %>

<script src="/js/main.js"></script>
</body>
</html>
