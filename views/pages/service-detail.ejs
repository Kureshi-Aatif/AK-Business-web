<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main-content">
  <!-- Breadcrumbs -->
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/services">Services</a></li>
        <li aria-current="page"><%= service.title %></li>
      </ol>
    </nav>
  </div>

  <!-- Service Hero Section -->
  <section class="section section--ice" aria-labelledby="service-title">
    <div class="container">
      <div class="service-hero-grid">
        <div class="reveal">
          <span class="badge badge--orange section-badge"><%= service.badge %></span>
          <h1 id="service-title" style="margin-bottom: 18px;"><%= service.title %></h1>
          <p style="font-size: 1.15rem; color: var(--color-slate); margin-bottom: 28px; line-height: 1.6;">
            <%= service.heroSubtitle %>
          </p>

          <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px;">
            <% service.chips.forEach(chip => { %>
              <span class="pill-item"><%= chip %></span>
            <% }) %>
          </div>

          <div style="display: flex; flex-wrap: wrap; gap: 14px;">
            <a href="/inquiry?service=<%= service.slug %>" class="btn btn--primary btn--lg">
              Inquire about this service
            </a>
            <% if (service.relatedPlan) { %>
              <a href="/plans" class="btn btn--outline btn--lg">
                Related Plan: <%= service.relatedPlan %>
              </a>
            <% } %>
          </div>
        </div>

        <div class="reveal" style="text-align: center;">
          <img src="<%= service.illustration %>" alt="<%= service.title %> illustration in Surat" width="380" height="380" style="max-height: 380px; width: auto; margin: 0 auto;">
        </div>
      </div>
    </div>
  </section>

  <!-- "What We Offer" Grid -->
  <section class="section" aria-labelledby="offer-heading">
    <div class="container">
      <div class="section-header reveal">
        <span class="badge badge--sky section-badge">Deliverables</span>
        <h2 id="offer-heading">What We Deliver for Your Brand in Surat</h2>
        <p>Every project is custom-engineered with production-ready standards, zero fluff, and full ownership transferred to you upon completion.</p>
      </div>

      <div class="offerings-grid">
        <% service.offerings.forEach(item => { %>
          <div class="offering-card reveal">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
              <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--color-sky); display: flex; align-items: center; justify-content: center; color: var(--color-royal);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <h3 style="font-size: 1.15rem; margin: 0;"><%= item.title %></h3>
            </div>
            <p style="font-size: 0.94rem; color: var(--color-slate); margin: 0;">
              <%= item.desc %>
            </p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Internal Linking to Related Guides / Blog Posts -->
  <% if (service.relatedPosts && service.relatedPosts.length > 0) { %>
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="card reveal" style="padding: 32px; background: #ffffff; border: 1px solid var(--color-line);">
        <span class="badge badge--sky" style="margin-bottom: 12px;">Related Guides &amp; Insights</span>
        <h3 style="margin-bottom: 16px;">Recommended Reading for Business Owners</h3>
        <div style="display: grid; grid-template-columns: 1fr; gap: 16px;">
          <% service.relatedPosts.forEach(rp => { %>
            <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--color-line); padding-bottom: 12px;">
              <a href="/blog/<%= rp.slug %>" style="font-weight: 700; color: var(--color-royal); text-decoration: none; font-size: 1.05rem;">
                <%= rp.title %> →
              </a>
              <span style="font-size: 0.85rem; color: var(--color-slate);">Read Guide</span>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <!-- "Perfect For" Pills & Tech Stack -->
  <section class="section section--ice" aria-labelledby="perfect-for-heading">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr; gap: 40px; align-items: start;" class="tech-perfect-grid">
        <!-- Perfect For -->
        <div class="card reveal" style="padding: 40px;">
          <span class="badge badge--sky" style="margin-bottom: 12px;">Target Sectors</span>
          <h3 id="perfect-for-heading" style="margin-bottom: 16px;">Perfect For These Businesses</h3>
          <p style="margin-bottom: 24px;">Our solutions are custom tuned for specific commercial workflows across Surat and Gujarat:</p>
          <div class="pills-cloud">
            <% service.perfectFor.forEach(item => { %>
              <div class="pill-item" style="background: #ffffff; border-color: var(--color-line); font-weight: 700;">
                <span style="color: var(--color-orange); margin-right: 4px;">&bull;</span> <%= item %>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Tech Stack & Delivery Standards -->
        <div class="card card--navy reveal" style="padding: 40px;">
          <span class="badge badge--orange" style="margin-bottom: 12px;">Standard Specifications</span>
          <h3 style="color: #fff; margin-bottom: 16px;">Technologies &amp; Quality Tools</h3>
          <p style="color: var(--color-sky); margin-bottom: 24px;">Built using industry-standard production tools and verified methodologies:</p>
          <div class="pills-cloud">
            <% service.techStack.forEach(tool => { %>
              <div class="pill-item" style="background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.2); color: #fff;">
                <%= tool %>
              </div>
            <% }) %>
          </div>

          <div style="margin-top: 32px; border-top: 1px solid rgba(255, 255, 255, 0.15); padding-top: 24px;">
            <a href="/inquiry?service=<%= service.slug %>" class="btn btn--primary" style="width: 100%;">
              Get a tailored quote for <%= service.title.split(' ')[0] %>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="cta-band reveal">
        <h2>Start Your <%= service.title %> Project</h2>
        <p>Get in touch with Aatif Kureshi to discuss your requirements, review timeline options, and receive a fixed transparent quote.</p>
        <div class="cta-band-actions">
          <a href="/inquiry?service=<%= service.slug %>" class="btn btn--primary btn--lg">Request project quote</a>
          <a href="/contact" class="btn btn--white btn--lg">Contact studio</a>
        </div>
      </div>
    </div>
  </section>
</main>

<!-- JSON-LD Service Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "<%= service.title %>",
  "provider": {
    "@type": "ProfessionalService",
    "name": "<%= business.name %>",
    "url": "<%= siteUrl %>"
  },
  "areaServed": {
    "@type": "City",
    "name": "Surat"
  },
  "description": "<%= service.heroSubtitle %>",
  "url": "<%= canonical %>"
}
</script>

<%- include('../partials/floating-wa') %>
<%- include('../partials/footer') %>

<script src="/js/main.js"></script>
</body>
</html>
