<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main-content">
  <!-- Breadcrumbs -->
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">Insights &amp; Blog</li>
      </ol>
    </nav>
  </div>

  <!-- Hero Header -->
  <section class="section section--ice" style="padding-bottom: 40px;">
    <div class="container text-center">
      <div class="section-header reveal" style="margin-bottom: 0;">
        <span class="badge badge--orange section-badge">Knowledge &amp; Strategies</span>
        <h1>AK Digital Studio Insights: Guides for Local Business Growth</h1>
        <p>
          In-depth guides, price breakdowns, and proven marketing playbooks written to help small business owners in Surat and Gujarat conquer the digital marketplace.
        </p>
      </div>
    </div>
  </section>

  <!-- Blog Grid -->
  <section class="section">
    <div class="container">
      <div class="blog-grid">
        <% posts.forEach(post => { %>
          <article class="blog-card reveal">
            <div style="background: var(--color-ice); height: 180px; display: flex; align-items: center; justify-content: center; border-bottom: 1px solid var(--color-line); padding: 20px;">
              <img src="<%= post.image || '/img/illustrations/web-design.svg' %>" alt="<%= post.title %>" width="160" height="140" style="max-height: 140px; width: auto; object-fit: contain;">
            </div>
            <div class="blog-card__body">
              <div class="blog-card__meta">
                <span><%= post.category || 'Guide' %></span>
                <span><%= post.readingTime || '5 min read' %></span>
              </div>
              <h2 class="blog-card__title">
                <a href="/blog/<%= post.slug %>"><%= post.title %></a>
              </h2>
              <p class="blog-card__snippet">
                <%= post.metaDesc || post.title %>
              </p>
              <div style="margin-top: auto; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-line); padding-top: 14px;">
                <span style="font-size: 0.82rem; color: var(--color-slate);"><%= post.dateFormatted %></span>
                <a href="/blog/<%= post.slug %>" style="font-weight: 700; color: var(--color-royal); text-decoration: none; font-size: 0.9rem;">
                  Read Article →
                </a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/floating-wa') %>
<%- include('../partials/footer') %>

<script src="/js/main.js"></script>
</body>
</html>
