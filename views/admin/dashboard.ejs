<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Sora:wght@600;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

  <!-- Header -->
  <header class="admin-header">
    <div class="admin-header-title">
      <div style="background: #ffffff; padding: 4px 10px; border-radius: 8px; display: inline-flex; align-items: center;">
        <img src="/img/logo.svg" alt="AK Digital Studio" style="height: 34px; width: auto;">
      </div>
      <h1>Agency Admin Portal</h1>
    </div>
    <div class="admin-nav-actions">
      <a href="/" target="_blank" class="btn btn--white btn--sm">View Public Site</a>
      <a href="/admin/logout" class="btn btn--outline btn--sm" style="color: #fff; border-color: rgba(255,255,255,0.3);">Logout</a>
    </div>
  </header>

  <main class="admin-container">
    <!-- Top Summary Stats Cards -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">Total Inquiries</div>
        <div class="stat-value"><%= stats.totalInquiries %></div>
        <div class="stat-sub">+<%= stats.newInquiriesThisWeek %> new this week</div>
      </div>

      <div class="stat-card">
        <div class="stat-label">General Messages</div>
        <div class="stat-value"><%= stats.totalContacts %></div>
        <div class="stat-sub">+<%= stats.newContactsThisWeek %> new this week</div>
      </div>

      <div class="stat-card" style="grid-column: span 2;">
        <div class="stat-label">Top Demand Categories</div>
        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px;">
          <% if (stats.interestStats && stats.interestStats.length > 0) { %>
            <% stats.interestStats.forEach(item => { %>
              <div style="background: var(--color-ice); border: 1px solid var(--color-line); padding: 4px 12px; border-radius: var(--radius-full); font-size: 0.84rem; font-weight: 600;">
                <span style="color: var(--color-royal);"><%= item.interest %>:</span> <strong><%= item.count %></strong>
              </div>
            <% }) %>
          <% } else { %>
            <div style="font-size: 0.88rem; color: var(--color-slate);">No submissions yet.</div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Controls Bar: Tabs, Search, Filters, CSV Export -->
    <div class="controls-bar">
      <!-- Tabs -->
      <div class="admin-tabs">
        <a href="/admin?tab=inquiries<%= search ? '&q=' + encodeURIComponent(search) : '' %><%= statusFilter ? '&status=' + encodeURIComponent(statusFilter) : '' %>" class="admin-tab <%= activeTab === 'inquiries' ? 'is-active' : '' %>">
          Project Inquiries (<%= inqTotalFiltered %>)
        </a>
        <a href="/admin?tab=contacts<%= search ? '&q=' + encodeURIComponent(search) : '' %><%= statusFilter ? '&status=' + encodeURIComponent(statusFilter) : '' %>" class="admin-tab <%= activeTab === 'contacts' ? 'is-active' : '' %>">
          Contact Messages (<%= cntTotalFiltered %>)
        </a>
      </div>

      <!-- Filter / Search Form -->
      <form method="GET" action="/admin" class="filter-form">
        <input type="hidden" name="tab" value="<%= activeTab %>">

        <input 
          type="text" 
          name="q" 
          class="filter-input" 
          placeholder="Search name, email, phone..." 
          value="<%= search %>"
        >

        <select name="status" class="filter-input">
          <option value="all" <%= (statusFilter === 'all' || !statusFilter) ? 'selected' : '' %>>All Statuses</option>
          <option value="new" <%= statusFilter === 'new' ? 'selected' : '' %>>New</option>
          <option value="contacted" <%= statusFilter === 'contacted' ? 'selected' : '' %>>Contacted</option>
          <option value="quoted" <%= statusFilter === 'quoted' ? 'selected' : '' %>>Quoted</option>
          <option value="won" <%= statusFilter === 'won' ? 'selected' : '' %>>Won / Client</option>
          <option value="lost" <%= statusFilter === 'lost' ? 'selected' : '' %>>Lost</option>
          <option value="spam" <%= statusFilter === 'spam' ? 'selected' : '' %>>Spam</option>
        </select>

        <button type="submit" class="btn btn--royal btn--sm">Filter</button>
        <% if (search || (statusFilter && statusFilter !== 'all')) { %>
          <a href="/admin?tab=<%= activeTab %>" class="btn btn--outline btn--sm">Reset</a>
        <% } %>

        <!-- Export CSV Button -->
        <a href="/admin/export/<%= activeTab %>.csv<%= search ? '?q=' + encodeURIComponent(search) : '' %><%= statusFilter ? '&status=' + encodeURIComponent(statusFilter) : '' %>" class="btn btn--primary btn--sm" style="margin-left: 8px;">
          Export CSV
        </a>
      </form>
    </div>

    <!-- Data Table -->
    <div class="table-wrapper">
      <% if (activeTab === 'inquiries') { %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Reference</th>
              <th>Date</th>
              <th>Client</th>
              <th>Phone / WA</th>
              <th>Interest</th>
              <th>Budget</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (inquiries && inquiries.length > 0) { %>
              <% inquiries.forEach(inq => { %>
                <tr class="data-row" data-type="inquiry" data-record='<%= JSON.stringify(inq) %>' style="cursor: pointer;">
                  <td><strong><%= inq.reference %></strong></td>
                  <td style="white-space: nowrap; font-size: 0.85rem; color: var(--color-slate);"><%= inq.created_at.split(' ')[0] %></td>
                  <td>
                    <div><strong><%= inq.name %></strong></div>
                    <div style="font-size: 0.82rem; color: var(--color-slate);"><%= inq.business_name || inq.email %></div>
                  </td>
                  <td><%= inq.phone %></td>
                  <td><span class="pill-item" style="padding: 2px 10px; font-size: 0.8rem;"><%= inq.interest %></span></td>
                  <td style="font-size: 0.88rem;"><%= inq.budget || '—' %></td>
                  <td>
                    <span class="status-pill status-<%= inq.status %>"><%= inq.status %></span>
                  </td>
                  <td>
                    <button type="button" class="btn btn--outline btn--sm" style="padding: 4px 10px; font-size: 0.8rem;">Details &rarr;</button>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" style="text-align: center; padding: 40px; color: var(--color-slate);">
                  No project inquiries found matching your filters.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      <% } else { %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Reference</th>
              <th>Date</th>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Subject</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (contacts && contacts.length > 0) { %>
              <% contacts.forEach(cnt => { %>
                <tr class="data-row" data-type="contact" data-record='<%= JSON.stringify(cnt) %>' style="cursor: pointer;">
                  <td><strong><%= cnt.reference %></strong></td>
                  <td style="white-space: nowrap; font-size: 0.85rem; color: var(--color-slate);"><%= cnt.created_at.split(' ')[0] %></td>
                  <td><strong><%= cnt.name %></strong></td>
                  <td><a href="mailto:<%= cnt.email %>"><%= cnt.email %></a></td>
                  <td><%= cnt.phone || '—' %></td>
                  <td><%= cnt.subject %></td>
                  <td>
                    <span class="status-pill status-<%= cnt.status %>"><%= cnt.status %></span>
                  </td>
                  <td>
                    <button type="button" class="btn btn--outline btn--sm" style="padding: 4px 10px; font-size: 0.8rem;">Details &rarr;</button>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" style="text-align: center; padding: 40px; color: var(--color-slate);">
                  No contact messages found matching your filters.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="/admin?tab=<%= activeTab %>&page=<%= i %><%= search ? '&q=' + encodeURIComponent(search) : '' %><%= statusFilter ? '&status=' + encodeURIComponent(statusFilter) : '' %>" class="page-btn <%= page === i ? 'is-active' : '' %>">
            <%= i %>
          </a>
        <% } %>
      </div>
    <% } %>
  </main>

  <!-- Slide-over Detail Drawer & Overlay -->
  <div class="drawer-overlay" id="drawer-overlay"></div>
  <aside class="admin-drawer" id="admin-drawer" aria-labelledby="drawer-title" role="dialog">
    <div class="drawer-header">
      <h3 id="drawer-title" style="font-size: 1.15rem; margin: 0;">Record Details</h3>
      <button type="button" id="drawer-close" class="btn btn--outline btn--sm" style="padding: 4px 10px;">&times; Close</button>
    </div>
    <div class="drawer-body" id="drawer-content">
      <!-- Dynamically filled by admin.js -->
    </div>
  </aside>

  <script src="/js/admin.js"></script>
</body>
</html>
