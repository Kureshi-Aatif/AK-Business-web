# ==============================================================================
# AK Digital Studio — Environment Configuration Specification
# All secrets and configurable keys MUST be defined here.
# ==============================================================================

# Server & Network Settings
PORT=3000
NODE_ENV=development
# Production: https://akdigitalstudio.com (no trailing slash)
SITE_URL=http://localhost:3000

# Security & Admin Authentication
# Change ADMIN_PASSWORD to a strong 16+ character password in production
ADMIN_PASSWORD=adminSecret123!
# Generate 64-character random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ak-digital-studio-secure-session-key-random-64-bytes
# Custom admin route URL (defaults to /admin, can be set to e.g. /studio-manager-77)
ADMIN_ROUTE_PATH=/admin

# Official Business Contact & NAP Details
BUSINESS_NAME="AK Digital Studio"
LEAD_DEVELOPER="Aatif Kureshi"
BUSINESS_PHONE="+91 76984 50003"
BUSINESS_EMAIL=AKdigitalstudio.org@gmail.com
INSTAGRAM_HANDLE=ak.digital_studio
CITY="Surat, Gujarat"
WHATSAPP_NUMBER="+917698450003"
PORTFOLIO_URL="https://drive.google.com/drive/folders/1rVIyFGmlAZ6Q309xKHGT4LxL0HUl6ej4?usp=drive_link"
GOOGLE_REVIEW_URL="https://g.page/r/your-google-profile-id/review"

# SEO & Search Engine Verification Tokens
# Set by owner after signing up for Search Console and Bing Webmaster
GSC_VERIFICATION=""
BING_VERIFICATION=""

# Web Analytics (Loaded strictly after visitor cookie consent)
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
GA_ID=""

# Nodemailer SMTP Settings (Optional in dev, console logs fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AK Digital Studio <noreply@akdigitalstudio.com>"
NOTIFY_TO=AKdigitalstudio.org@gmail.com

# Anti-Bot Protection: Cloudflare Turnstile (Optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
