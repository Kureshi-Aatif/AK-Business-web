{
  "name": "ak-digital-studio",
  "version": "2.0.0",
  "description": "Production static website and free serverless API for AK Digital Studio (Surat, Gujarat)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "node scripts/check-links.mjs",
    "validate": "node build.mjs && node scripts/check-links.mjs",
    "dev": "wrangler pages dev dist",
    "deploy": "wrangler pages deploy dist --project-name=ak-digital-studio"
  },
  "keywords": [
    "ak-digital-studio",
    "website-design-surat",
    "cloudflare-pages",
    "cloudflare-d1",
    "static-site"
